# mock: sign in with the demo accounts and read fixtures from src/mocks (default).
# api:  sign in through FastAPI POST /auth/login and read data from API_URL.
AUTH_MODE=mock

# Signs the httpOnly session cookie. Generate one with: openssl rand -base64 32
SESSION_SECRET=d7u2+dd0miWTmecIIKQBM6QvJ5H83L34Di05irZtQvY=


# FastAPI base URL, used when AUTH_MODE=api.
API_URL=http://localhost:8000
